{
  "name": "solder-cli",
  "version": "0.1.25",
  "description": "Solder CLI tools for IDL management",
  "type": "module",
  "bin": {
    "solder-cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
