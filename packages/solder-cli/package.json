    "ora": "^8.0.1",
    "fs-extra": "^11.2.0",
    "@solder-build/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.8.3"
