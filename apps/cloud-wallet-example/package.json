{
  "name": "cloud-wallet-example",
  "version": "1.0.0",
  "description": "Proof of concept for Solder Cloud Wallet integration with GCP KMS and AWS KMS",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "airdrop:gcp": "node dist/gcp/airdrop.js",
    "sign-message:gcp": "node dist/gcp/sign-message.js",
    "transfer:gcp": "node dist/gcp/simple-transfer.js"
  },
  "dependencies": {
    "@solder-build/core": "workspace:*",
    "@solana/kit": "^4.0.0",
    "@solana/rpc": "^4.0.0",
    "@solana/web3.js": "^1.98.4",
    "@solana/programs": "^4.0.0",
    "@solana-program/system": "^0.9.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "solana",
    "cloud-wallet",
    "gcp-kms",
    "aws-kms",
    "solder",
    "blockchain"
  ],
  "author": "",
  "license": "ISC"
}
